PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carely
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_a_strong_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Production (Vercel): https://your-carely-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=carelycorp237@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Campay (Mobile Money) ────────────────────────────────────────────────────
CAMPAY_BASE_URL=https://campay.net/api/v2
CAMPAY_APP_USERNAME=your-campay-username
CAMPAY_APP_PASSWORD=your-campay-password

# ── App URLs ─────────────────────────────────────────────────────────────────
# Used in emails to build links/logo URLs
APP_URL=http://localhost:5173
CARELY_LOGO_URL=http://localhost:5173/logo.png
