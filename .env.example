# ==============================================================================
# Carely Backend — Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit the real .env file to git.
# ==============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
# Render assigns PORT automatically in production — do not hardcode it.
PORT=5000
NODE_ENV=development    # set to "production" on Render

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production: set this to your Vercel frontend URL on Render dashboard.
FRONTEND_URL=http://localhost:5173

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# PRODUCTION (Render + Neon):
#   Set DATABASE_URL to the connection string from Neon's dashboard.
#   Neon strings look like:
#     postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   The pg driver will automatically use this if DATABASE_URL is set.
#   Do NOT also set DB_HOST/DB_NAME/etc. when DATABASE_URL is present.
#
# LOCAL DEVELOPMENT:
#   Leave DATABASE_URL unset and use the individual vars below instead.
#
DATABASE_URL=

# Individual DB vars — only used when DATABASE_URL is NOT set (local dev):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carely
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate strong random strings, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_strong_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Use a Gmail App Password (not your account password).
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=carelycorp237@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Campay (Mobile Money payments) ──────────────────────────────────────────
# Production URL is https://campay.net/api (demo: https://demo.campay.net/api)
CAMPAY_BASE_URL=https://campay.net/api
CAMPAY_APP_USERNAME=your-campay-username
CAMPAY_APP_PASSWORD=your-campay-password

# ── App URLs (used in outgoing emails) ──────────────────────────────────────
# Set to your Vercel frontend URL in production.
APP_URL=http://localhost:5173
CARELY_LOGO_URL=http://localhost:5173/logo.png
